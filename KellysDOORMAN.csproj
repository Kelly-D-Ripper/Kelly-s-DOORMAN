<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version Condition="'$(ServerBuild)' != 'true'">1.3.5</Version>
    <Version Condition="'$(ServerBuild)' == 'true'">1.0.0</Version>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
    <ManagedDir>$(GameDir)\NuclearOption_Data\Managed</ManagedDir>
    <AssemblyName Condition="'$(ServerBuild)' != 'true'">KellysJOINCHECK</AssemblyName>
    <AssemblyName Condition="'$(ServerBuild)' == 'true'">KellysJOINCHECKServer</AssemblyName>
    <OutputPath>bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(AssemblyName)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="metadata\client\doorman.json" LogicalName="doorman.json" Condition="'$(ServerBuild)' != 'true'" />
    <EmbeddedResource Include="metadata\client\doorman.png" LogicalName="doorman.png" Condition="'$(ServerBuild)' != 'true' and Exists('metadata\client\doorman.png')" />
    <Compile Include="src\Diagnostics.cs" />
    <Compile Include="src\Compatibility.cs" />
    <Compile Include="src\ClientPlugin.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModData.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\SavedModLists.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\InstalledContentMetadata.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModListWorkflow.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\NativeModListsUi.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\NativeScrollbars.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\MapFiles.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\MapBundleBridge.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\MapWorkflow.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\NativeMapsUi.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\EmbeddedModPreview.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModUpdateData.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModUpdateFiles.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModUpdateService.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Reference Include="System.Net.Http" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModImageHeader.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModStateSnapshot.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModCatalog.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModMenuEntries.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\NommMetadata.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\NommMetadataService.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ServerSetupData.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ServerModWorkflow.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModsRestartWorkflow.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\RestartStatus.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\WindowsRestartLauncher.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BlueprinterReload.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ModManager.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\NativeModsUi.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\NativeMenuLifecycle.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\MenuScene.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\JoinSummary.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\NativeJoinUi.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\Favourites.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BrowserUi.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BrowserHooks.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BrowserQueryPatch.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BrowserPresentation.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BrowserIconGeometry.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\DrawnBrowserIcon.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BrowserServerFilter.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BrowserServerList.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\BrowserDiscovery.cs" Condition="'$(ServerBuild)' != 'true'" />
    <Compile Include="src\ServerPlugin.cs" Condition="'$(ServerBuild)' == 'true'" />
    <Compile Include="src\Advertisement.cs" Condition="'$(ServerBuild)' == 'true'" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="System.IO.Compression" HintPath="$(ManagedDir)\System.IO.Compression.dll" Private="false" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(ManagedDir)\com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Mono.Cecil" HintPath="$(GameDir)\BepInEx\core\Mono.Cecil.dll" Private="false" Condition="'$(ServerBuild)' != 'true'" />
    <Reference Include="Mirage" HintPath="$(ManagedDir)\Mirage.dll" Private="false" Condition="'$(ServerBuild)' != 'true'" />
    <Reference Include="Unity.Addressables" HintPath="$(ManagedDir)\Unity.Addressables.dll" Private="false" Condition="'$(ServerBuild)' != 'true'" />
    <Reference Include="Unity.ResourceManager" HintPath="$(ManagedDir)\Unity.ResourceManager.dll" Private="false" Condition="'$(ServerBuild)' != 'true'" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" Condition="'$(ServerBuild)' != 'true'" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" Condition="'$(ServerBuild)' != 'true'" />
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="GameDir must point to an installed Nuclear Option game with BepInEx 5." />
  </Target>
</Project>
