<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <None Update="NativeBrowserLayout.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="HookSmoke\**\*.cs" />
    <Compile Include="..\src\Diagnostics.cs" Link="Diagnostics.cs" />
    <Compile Include="..\src\JoinSummary.cs" Link="JoinSummary.cs" />
    <Compile Include="..\src\Advertisement.cs" Link="Advertisement.cs" />
    <Compile Include="..\src\Favourites.cs" Link="Favourites.cs" />
    <Compile Include="..\src\BrowserQueryPatch.cs" Link="BrowserQueryPatch.cs" />
    <Compile Include="..\src\BrowserPresentation.cs" Link="BrowserPresentation.cs" />
    <Compile Include="..\src\BrowserIconGeometry.cs" Link="BrowserIconGeometry.cs" />
    <Compile Include="..\src\BrowserServerFilter.cs" Link="BrowserServerFilter.cs" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" />
    <Reference Include="Mono.Cecil" HintPath="$(GameDir)\BepInEx\core\Mono.Cecil.dll" />
  </ItemGroup>
</Project>
